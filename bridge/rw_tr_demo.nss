{ return JsonParse("[{\"id\":0,\"kind\":\"dialogue_entry\",\"text\":\"Welcome to the Kingdom of Role Weaver. What would you like to know?\",\"approved\":1},{\"id\":1,\"kind\":\"dialogue_entry\",\"text\":\"Visit the merchant's stall. You can ask about the goods and try negotiating a better price.\",\"approved\":1},{\"id\":2,\"kind\":\"dialogue_entry\",\"text\":\"Captain Beran can explain your duties. The cleric can tell you about our faith.\",\"approved\":1},{\"id\":3,\"kind\":\"dialogue_entry\",\"text\":\"Read the noticeboard, examine objects, and speak with the people around you.\",\"approved\":1},{\"id\":4,\"kind\":\"dialogue_reply\",\"text\":\"Where can I buy supplies?\",\"approved\":1},{\"id\":5,\"kind\":\"dialogue_reply\",\"text\":\"Who can tell me about the kingdom?\",\"approved\":1},{\"id\":6,\"kind\":\"dialogue_reply\",\"text\":\"How can I explore the demonstration?\",\"approved\":1},{\"id\":7,\"kind\":\"dialogue_reply\",\"text\":\"Goodbye.\",\"approved\":1},{\"id\":8,\"kind\":\"dialogue_reply\",\"text\":\"Ask another question.\",\"approved\":1}]"); }
